  "accessibility": {
    "minimumTouchTargetPx": 44,
    "focusIndicator": "2px solid #275f8f",
    "focusOffsetPx": 2,
    "reducedMotionSupported": true,
    "colorAloneConveysStatus": false
  },
  "figmaSyncStatus": "SPEC_READY_VIEW_ONLY_NO_CANVAS_MUTATION"
