  "typography": {
    "fontFamily": {
      "sans": "Arial, Helvetica, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "display": "clamp(2rem, 4vw, 4rem)"
    },
    "lineHeight": {
      "tight": 1.2,
      "body": 1.55,
      "relaxed": 1.7
    },
    "fontWeight": {
      "regular": 400,
      "medium": 600,
      "strong": 800,
      "brand": 900
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
