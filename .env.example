# Protected pilot identity and durable tenant evidence plane
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Distributed public intake and protected mutation rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace alternative when the resource prefix is UPSTASH_REDIS_REST
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# Optional approved CRM handoff
SCRIMED_PILOT_INTAKE_WEBHOOK_URL=
SCRIMED_PILOT_INTAKE_WEBHOOK_TOKEN=

# Server-only token for the private no-PHI pilot intake ledger
SCRIMED_PILOT_INTAKE_PERSISTENCE_TOKEN=

# Execution attempt durable-store rollout controls
# Apply supabase/migrations/20260627191852_execution_attempt_durable_store.sql
# and supabase/migrations/20260627214607_execution_attempt_durable_store_rpc_hardening.sql
# and supabase/migrations/20260627222843_execution_attempt_durable_store_advisor_alignment.sql
# before enabling authenticated record/replay/review pilots.
SCRIMED_EXECUTION_ATTEMPT_DURABLE_STORE_ENABLED=false
SCRIMED_EXECUTION_ATTEMPT_DEFAULT_REGION=us

# SCRIMED Work durable-store rollout controls
# Apply supabase/migrations/20260709193000_scrimed_work_durable_store.sql
# in a non-production Supabase project and run smoke:scrimed-work:authenticated
# before enabling protected SCRIMED Work mutations.
SCRIMED_WORK_PROTECTED_WRITES_ENABLED=false
SCRIMED_WORK_DURABLE_STORE_ENABLED=false
SCRIMED_WORK_MIGRATIONS_VERIFIED=false
SCRIMED_WORK_MIGRATION_EVIDENCE_ID=
SCRIMED_WORK_DEFAULT_WORKSPACE_SLUG=atlas-synthetic-evaluation

# Read-only cross-platform release evidence snapshot. No provider credentials or raw logs are stored.
SCRIMED_CROSS_PLATFORM_EVIDENCE_ENABLED=true

# Production release provenance. Production builds fail closed unless a release
# steward enables enforcement and supplies the exact approved 40-character SHA.
SCRIMED_RELEASE_PROVENANCE_ENFORCED=false
SCRIMED_APPROVED_RELEASE_SHA=

# Authenticated smoke only. Never commit real bearer tokens.
SCRIMED_BASE_URL=https://app.scrimedsolutions.com
SCRIMED_WORKSPACE_SLUG=atlas-synthetic-evaluation
SCRIMED_REQUIRE_AUTHENTICATED_SMOKE=false
SCRIMED_BEARER_TOKEN=
SCRIMED_AAL2_MAX_TOKEN_SECONDS=3900
SCRIMED_AAL2_MIN_REMAINING_SECONDS=60
SCRIMED_SUPABASE_SESSION_JSON=
