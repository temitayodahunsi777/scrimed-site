{
  "schemaVersion": "scrimed-performance-budgets-v2",
  "measurementBoundary": "Synthetic and public no-PHI preview traffic only",
  "minimumLiveSampleCount": 30,
  "materialRegressionPercent": 20,
  "budgets": {
    "serverRouteP95Ms": 500,
    "serverRouteP99Ms": 1200,
    "pageLoadP75Ms": 2500,
    "firstLoadJavaScriptBytes": 350000,
    "hydrationP75Ms": 1000,
    "serverlessExecutionMs": 10000,
    "modelLatencyMs": 15000,
    "agentWorkflowLatencyMs": 30000,
    "productConsoleApiBytes": 90000,
    "governanceEvaluationP95Ms": 250,
    "evidenceLookupP95Ms": 300,
    "pilotControlOverheadP95Ms": 150
  },
  "routeInventory": {
    "builtRoutesArtifact": "artifacts/build/routes.json",
    "generationArtifact": "artifacts/build/render-inventory.json",
    "manualExpectedCountsAllowed": false,
    "buildMayOverwriteBaseline": false,
    "intentionalUpdateCommand": "npm run update:p34-build-inventory"
  },
  "enforcement": {
    "deterministicBuildBudgets": "fail",
    "livePercentileBudgetsBeforeMinimumSamples": "review_required",
    "clinicalSafetyOrPrivacyRegression": "fail_closed"
  }
}
